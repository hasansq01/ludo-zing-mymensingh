rules_version = '2';
// Ludo Zing Mymensingh — each signed-in player can read and write only their own progress document:
// players/{uid} = { v, prefs, profile, updatedAt }. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'prefs', 'profile', 'updatedAt']);
    }
  }
}
