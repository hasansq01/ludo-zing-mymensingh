; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ludo Zing Mymensingh"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false
run/low_processor_mode=false
config/icon="res://assets/icon/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.0901961, 0.0588235, 0.133333, 1)

[autoload]

Save="*res://scripts/core/save.gd"
Sound="*res://scripts/audio/sound.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/notifications/plugin.cfg", "res://addons/play_games/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

environment/defaults/default_clear_color=Color(0.0901961, 0.0588235, 0.133333, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/positional_shadow/atlas_16_bits=false
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/atlas_size.mobile=2048
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=1
textures/vram_compression/import_etc2_astc=true
