msgid "Join these two pawns?"
msgstr "এই দুই গুটি জোড়া বাঁধবে?"

#. Ludo match HUD · ludo_hud.gd _build_pair_box()
#: scripts/ui/ludo_hud.gd:280
msgid "Pair up"
msgstr "জোড়া বাঁধো"

#. Ludo match HUD · ludo_hud.gd _build_pair_box()
#: scripts/ui/ludo_hud.gd:281
msgid "Keep single"
msgstr "একা রাখো"

# REVIEW: team chip, %s is a colour
#. Ludo match HUD · ludo_hud.gd team_chip()
#: scripts/ui/ludo_hud.gd:660
msgid "Helping %s"
msgstr "সাহায্য: %s"

#. Ludo match HUD · ludo_hud.gd team_chip()
#: scripts/ui/ludo_hud.gd:660
msgid "Roll a 6 to help"
msgstr "সাহায্য করতে 6 তোলো"

# REVIEW: team chip under a tile, %s is a colour name (e.g. 'হলুদ-এর সাথে')
