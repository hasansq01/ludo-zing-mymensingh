extends "res://tests/test_suite.gd"
## Turn-flow checks the browser tests don't cover: three 6s, stuck rolls, the streamlined unit choice (units(),
## no Single / Pair step), automatic pairing and the "Ask before pairing" house rule, the computer's pairing rule,
## new games, rewards and JSON round trips.

func run() -> void:
	var s: Dictionary
	var t: Array

	# ---- three 6s, stuck rolls ----
	t = base(); t[0][0] = 10; s = state(t)
	play(s, 6, 0); play(s, 6, 0)
	check("two 6s: still the same player's turn", s.turn == 0 and s.sixes == 2 and s.tok[0][0] == 22, [s.turn, s.sixes, s.tok[0]])
	var ev := Ludo.apply_roll(s, 6)
	check("third 6 in a row: turn lost, nothing moves", s.turn == 1 and s.sixes == 0 and s.tok[0][0] == 22 and ev.any(func(e): return e.type == "three_sixes"), [s.turn, s.tok[0]])
	s = state(base())
	ev = Ludo.apply_roll(s, 4)
	check("nothing can move on a 4 from base: turn passes", s.turn == 1 and ev.any(func(e): return e.type == "stuck" and e.reason == "No move this time."), ev)
	t = base(); t[0] = [56, 56, 56, 54]; s = state(t)
	ev = Ludo.apply_roll(s, 6)
	check("stuck on a 6 still rolls again", s.turn == 0 and s.phase == "roll" and s.sixes == 1, [s.turn, s.sixes])
	check("…and the reason says so", ev.any(func(e): return e.type == "stuck" and e.reason == "No move. Roll again."), ev)
	t = base(); t[0][0] = 10; t[3][0] = prog(3, 12); t[3][1] = prog(3, 12)   # a Blue pair two squares ahead of Red
	s = state(t, [{c = 3, a = 0, b = 1}])
	ev = Ludo.apply_roll(s, 4)
	check("blocked by a pair: stuck reason names whose pair", s.turn == 1 and ev.any(func(e): return e.type == "stuck" and e.reason == "Blocked by Blue's pair."), ev)
	var vs := {players = ["human", "cpu", "cpu", "cpu"], names = ["You", "Mocha", "Biscotti", "Espresso"]}
	t = base(); t[1][0] = 10; t[0][0] = prog(0, 25); t[0][1] = prog(0, 25)   # your pair 2 squares ahead of Mocha (abs 23)
	s = state(t, [{c = 0, a = 0, b = 1}], vs.merged({turn = 1}))
	ev = Ludo.apply_roll(s, 4)
	check("…\"your pair\" when it is yours", ev.any(func(e): return e.type == "stuck" and e.reason == "Blocked by your pair."), ev)
	t = base(); t[1][0] = 10; t[0][0] = prog(0, 25); t[0][1] = prog(0, 25); t[1][1] = 56; t[1][2] = 56; t[1][3] = 56
	s = state(t, [{c = 0, a = 0, b = 1}], vs.merged({turn = 1}))
	ev = Ludo.apply_roll(s, 6)
	check("…blocked on a 6 adds Roll again.", s.turn == 1 and ev.any(func(e): return e.type == "stuck" and e.reason == "Blocked by your pair. Roll again."), ev)
	t = base(); t[0][0] = prog(0, 30); t[0][1] = prog(0, 30); s = state(t, [{c = 0, a = 0, b = 1}])
	check("pair on an odd roll: needs an even roll", Ludo.stuck_reason(s, 0, 5) == "A pair needs an even roll.")
	check("stuck texts say pawn, never token", ["No move this time.", Ludo.stuck_reason(s, 0, 5), Ludo.stuck_reason(state(base()), 0, 6)].all(func(x): return not x.contains("token")))

	# ---- every legal unit may be tapped: no Single / Pair step ----
	t = base(); t[0][0] = 10; t[0][1] = 10; t[0][2] = 20; t[0][3] = 30; s = state(t, [{c = 0, a = 0, b = 1}])
	ev = Ludo.apply_roll(s, 4)
	check("even roll with a pair and singles movable: straight to choose, no pick", s.phase == "choose" and ev.any(func(e): return e.type == "choose") and not ev.any(func(e): return e.type == "pick"), ev)
	var us := Ludo.units(s)
	check("units(): the pair once (both pawns) and each single", us.size() == 3 and us[0].tokens == [0, 1] and us[0].pair and us[0].token == 0 and us[1].tokens == [2] and not us[1].pair and us[2].tokens == [3], us)
	check("units(): mover, from and destination per unit", us.all(func(u): return u.mover == 0) and us[0].from == 10 and us[0].to == 12 and us[1].from == 20 and us[1].to == 24 and us[2].to == 34, us)
	check("unit_for_token: either pawn of the pair maps to the pair", Ludo.unit_for_token(s, 1).tokens == [0, 1] and Ludo.unit_for_token(s, 0).token == 0 and Ludo.unit_for_token(s, 3).tokens == [3])
	check("no auto-move when the units differ", Ludo.auto_move_token(s) == -1)
	var tok_json := JSON.stringify(Ludo.units(s))
	check("units() is plain data (JSON-safe)", JSON.parse_string(tok_json).size() == 3)
	Ludo.move(s, 1)                                # tapping the second pawn of the pair moves the whole pair
	check("tapping either pawn of a pair moves the pair half the roll", s.tok[0][0] == 12 and s.tok[0][1] == 12 and s.tok[0][2] == 20, s.tok[0])
	t = base(); t[0][0] = 10; t[0][1] = 10; t[0][2] = 20; s = state(t, [{c = 0, a = 0, b = 1}])
	Ludo.apply_roll(s, 3)
	us = Ludo.units(s)
	check("odd roll: only singles are legal units, the paired pawns are not", us.size() == 1 and us[0].tokens == [2] and Ludo.unit_for_token(s, 0).is_empty() and Ludo.unit_for_token(s, 1).is_empty(), us)
	check("…a paired pawn never moves alone", Ludo.move(s, 0).is_empty() and s.tok[0][0] == 10 and s.tok[0][1] == 10)
	check("…the one single moves by itself", Ludo.auto_move_token(s) == 2)
	t = base(); t[0][0] = 10; t[0][1] = 10; t[0][2] = 20; t[0][3] = 30; s = state(t, [{c = 0, a = 0, b = 1}])
	Ludo.apply_roll(s, 4)
	check("legacy choose_pick still narrows the choice", Ludo.choose_pick(s, "single") and Ludo.units(s).size() == 2 and Ludo.move(s, 0).is_empty())
	check("…and refuses unknown kinds", not Ludo.choose_pick(s, "triple"))
	Ludo.move(s, 3)
	check("…a single still moves after it", s.tok[0][3] == 34 and s.pick == "")
	t = base(); t[0][0] = 15; t[0][1] = 15; t[0][2] = 30; s = state(t)   # two loose pawns on one square
	Ludo.apply_roll(s, 3)
	check("two loose pawns on one square plus another pawn: still a choice", Ludo.auto_move_token(s) == -1 and Ludo.units(s).size() == 3)
	t = base(); t[0][0] = 15; t[0][1] = 15; s = state(t)
	Ludo.apply_roll(s, 3)
	check("…every option the same move: it goes by itself", Ludo.auto_move_token(s) == 0 and Ludo.units(s).size() == 2)
	t = base(); t[1][0] = 10; t[1][1] = 10; t[1][2] = 20; s = state(t, [{c = 1, a = 0, b = 1}], {players = ["human", "cpu", "cpu", "cpu"], turn = 1})
	Ludo.apply_roll(s, 4)
	check("the computer gets the same choose phase", s.phase == "choose")
	s = state(base())
	check("units() is empty with nothing to move", Ludo.units(s).is_empty() and Ludo.unit_for_token(s, 0).is_empty())

	# ---- pairing: automatic by default (humans like computers), asked with the house rule ----
	t = base(); t[0][0] = 10; t[0][1] = 12; s = state(t)
	play(s, 2, 0)
	check("default: a human landing on a loose own pawn pairs up by itself", s.pairs == [{c = 0, a = 0, b = 1}] and s.phase == "roll" and s.turn == 1, [s.pairs, s.phase, s.turn])
	t = base(); t[0][0] = 6; t[0][1] = 8; s = state(t)
	play(s, 2, 0)
	check("default: …but not on a safe (star) square", s.pairs.is_empty() and s.tok[0][0] == 8 and s.phase == "roll")
	t = base(); t[0][0] = 6; t[0][1] = 12; s = state(t)
	Ludo.apply_roll(s, 6)
	ev = Ludo.move(s, 0)
	check("default: auto pair after a 6 reports pair_formed and the same player rolls again", ev.any(func(e): return e.type == "pair_formed" and e.human) and s.turn == 0 and s.phase == "roll" and not ev.any(func(e): return e.type == "pair_offer"), ev)
	t = base(); t[0][0] = 10; t[0][1] = 12; s = state(t, [], {pair_ask = true})
	play(s, 2, 0)
	check("pair_ask: a human landing on a loose own pawn is asked", s.phase == "pair_ask" and s.pending.partner == 1 and s.turn == 0)
	check("no roll while the question is open", Ludo.apply_roll(s, 3).is_empty())
	Ludo.answer_pair(s, true)
	check("yes forms the pair; no extra roll for pairing", s.pairs == [{c = 0, a = 0, b = 1}] and s.turn == 1 and s.phase == "roll", [s.pairs, s.turn])
	t = base(); t[0][0] = 10; t[0][1] = 12; s = state(t, [], {pair_ask = true})
	play(s, 2, 0); Ludo.answer_pair(s, false)
	check("no leaves both single", s.pairs.is_empty() and s.turn == 1)
	t = base(); t[0][0] = 6; t[0][1] = 12; s = state(t, [], {pair_ask = true})
	play(s, 6, 0)
	check("question after a 6: the extra roll comes after the answer", s.phase == "pair_ask")
	Ludo.answer_pair(s, true)
	check("…then the same player rolls again", s.turn == 0 and s.phase == "roll" and s.pairs.size() == 1)
	t = base(); t[0][0] = 6; t[0][1] = 8; s = state(t, [], {pair_ask = true})
	play(s, 2, 0)
	check("pair_ask: on a star square the human is still asked (as before)", s.phase == "pair_ask")
	t = base(); t[1][0] = 10; t[1][1] = 12; s = state(t, [], {players = ["human", "cpu", "cpu", "cpu"], turn = 1, pair_ask = true})
	Ludo.apply_roll(s, 2); Ludo.move(s, 0)
	check("pair_ask never asks the computer", s.pairs.size() == 1 and s.phase == "roll")
	s = Ludo.new_game(["human", "cpu", "off", "off"], false, {pair_ask = true})
	check("new_game opts.pair_ask", s.pair_ask == true and Ludo.new_game(["human", "cpu", "off", "off"]).pair_ask == false)
	var cpu := {players = ["cpu", "human", "cpu", "cpu"]}
	t = base(); t[0][0] = 10; t[0][1] = 12; s = state(t, [], cpu)
	Ludo.apply_roll(s, 2); Ludo.move(s, 0)
	check("the computer pairs up off safe squares without asking", s.pairs.size() == 1 and s.phase == "roll")
	t = base(); t[0][0] = 6; t[0][1] = 8; s = state(t, [], cpu)
	Ludo.apply_roll(s, 2); Ludo.move(s, 0)
	check("…but not on a safe (star) square", s.pairs.is_empty() and s.tok[0][0] == 8)

	# ---- new games, rewards, JSON ----
	s = Ludo.new_game(["off", "human", "cpu", "off"])
	check("new game: first active seat starts, names follow the seats", s.turn == 1 and s.names == ["", "You", "Mocha", ""] and s.view == 1, [s.turn, s.names])
	s = Ludo.new_game(["human", "human", "off", "off"])
	check("Pass & Play names are the colours", s.names == ["Red", "Green", "", ""])
	t = base(); t[0] = [56, 56, 56, 55]; s = state(t, [], {players = ["human", "cpu", "off", "off"], names = ["You", "Mocha", "", ""]})
	play(s, 1)
	check("beating the computer pays the win reward", s.phase == "over" and Ludo.win_reward(s) == Ludo.WIN_REWARD)
	t = base(); t[1] = [56, 56, 56, 55]; s = state(t, [], {players = ["human", "cpu", "off", "off"], names = ["You", "Mocha", "", ""], turn = 1})
	play(s, 1)
	check("losing to the computer pays no win reward", s.phase == "over" and s.winner == 1 and Ludo.win_reward(s) == 0)
	check("…but a small participation reward", Ludo.play_reward(s) == Ludo.PLAY_REWARD and Ludo.PLAY_REWARD > 0 and Ludo.PLAY_REWARD < Ludo.WIN_REWARD)
	var copy: Dictionary = LudoMatch.result_copy(s)
	check("loss headline from your side: place, then who won", copy.title == "You finished 2nd" and copy.sub == "Mocha won", copy)
	t = base(); t[0] = [56, 56, 56, 55]; s = state(t)
	play(s, 1)
	check("Pass & Play pays nothing", s.phase == "over" and Ludo.win_reward(s) == 0 and Ludo.play_reward(s) == 0)
	check("Pass & Play headline: the winner", LudoMatch.result_copy(s).title == "Red wins!", LudoMatch.result_copy(s))
	t = base(); t[0] = [56, 56, 56, 55]; s = state(t, [], {players = ["human", "cpu", "off", "off"], names = ["You", "Mocha", "", ""]})
	play(s, 1)
	check("a win pays no participation reward on top", Ludo.play_reward(s) == 0 and LudoMatch.result_copy(s).title == "You win!" and LudoMatch.result_copy(s).sub == "All four pawns home!", LudoMatch.result_copy(s))
	check("a game not over pays nothing", Ludo.play_reward(Ludo.new_game(["human", "cpu", "off", "off"])) == 0)
	s = Ludo.new_game(["human", "cpu", "cpu", "cpu"], true)
	var round_trip: Dictionary = JSON.parse_string(JSON.stringify(s))
	check("state survives a JSON round trip (save files, network)", round_trip.keys().size() == s.keys().size() and round_trip.tok.size() == 4 and round_trip.teams == true)
